# Defaults serve only this computer. Reload is opt-in: uv run python run.py --reload
HOST=127.0.0.1
PORT=8000
DEBUG=false

# New installations use the OS application-data directory.
# An existing backend/arcade_nexus.db is retained automatically.
# DATA_DIR="/absolute/path/to/ArcadeNexus"
# Relative database paths are resolved against the backend directory.
# DATABASE_URL="sqlite+aiosqlite:///./arcade_nexus.db"

# CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
# ALLOWED_HOSTS='["localhost","127.0.0.1","[::1]"]'
# Enable only while developing catalog metadata; this does not install game code.
ALLOW_GAME_CREATION=false
MAX_REQUEST_BYTES=1048576
